        {
          "name": "GET /demandes?statut=EN_ATTENTE (spécialiste)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });",
