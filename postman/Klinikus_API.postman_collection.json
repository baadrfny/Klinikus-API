                  "key": "specialite",
                  "value": "CARDIOLOGIE"
                }
              ]
            },
            "description": "Rôle GENERALISTE. Liste des spécialistes d'une spécialité, triée par tarif croissant.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{generaliste_email}}",
                  "type": "string"
