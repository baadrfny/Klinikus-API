    {
      "name": "3 - Demandes",
      "item": [
        {
          "name": "POST /demandes (créer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', function () { pm.response.to.have.status(201); });",
                  "var d = pm.response.json();",
                  "pm.test('Statut EN_ATTENTE', function () { pm.expect(d.statut).to.eql('EN_ATTENTE'); });",
                  "pm.collectionVariables.set('demandeId', d.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/demandes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demandes"
              ]
            },
            "description": "Rôle GENERALISTE. Enregistre l'id créé dans la variable {{demandeId}} utilisée par le PUT. specialisteId 3 = specialiste@klinikus.ma.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{generaliste_email}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{generaliste_password}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultationId\": 1,\n  \"specialisteId\": 3,\n  \"question\": \"Question de test\",\n  \"priorite\": \"URGENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "GET /demandes?consultationId=2 (généraliste)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Réponse = tableau', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
                ]
              }
