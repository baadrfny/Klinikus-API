{
  "info": {
    "name": "Klinikus API",
    "description": "API de télé-expertise médicale. Authentification HTTP Basic au niveau de la collection ({{email}} / {{password}}), surchargée par rôle sur chaque requête. Importer aussi Klinikus_API.postman_environment.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{email}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "demandeId",
      "value": "15"
    }
  ],
  "item": [
    {
      "name": "1 - Authentification",
      "item": [
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Identité renvoyée', function () { var j = pm.response.json(); pm.expect(j).to.have.property('role'); pm.expect(j).to.have.property('email'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Utilise l'authentification Basic de la collection ({{email}} / {{password}})."
          }
        },
        {
          "name": "GET /auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
