            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/demandes?statut=EN_ATTENTE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demandes"
              ],
              "query": [
                {
                  "key": "statut",
                  "value": "EN_ATTENTE"
                }
              ]
            },
            "description": "Rôle SPECIALISTE. Uniquement les demandes adressées au spécialiste connecté.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{specialiste_email}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{specialiste_password}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PUT /demandes/{{demandeId}}/reponse (répondre)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Statut TERMINEE', function () { pm.expect(pm.response.json().statut).to.eql('TERMINEE'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/demandes/{{demandeId}}/reponse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "demandes",
                "{{demandeId}}",
                "reponse"
              ]
            },
            "description": "Rôle SPECIALISTE propriétaire de la demande. Lancer après le POST (la demande créée est adressée à specialiste@klinikus.ma).",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{specialiste_email}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{specialiste_password}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"avis\": \"L'ECG montre une fibrillation auriculaire à réponse ventriculaire rapide. Pas de signe d'ischémie aiguë.\",\n  \"recommandations\": \"Holter ECG sur 24h, échocardiographie transthoracique, bilan thyroïdien et ionogramme. Anticoagulation à discuter selon le score CHA2DS2-VASc.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
